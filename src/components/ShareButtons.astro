---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const targets = [
  {
    label: '微博',
    href: `https://service.weibo.com/share/share.php?url=${encodedUrl}&title=${encodedTitle}`,
  },
  {
    label: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
];
---

<div class="share">
  <span class="share__label mono">分享</span>

  <button class="share__btn mono" type="button" data-share-copy data-url={url}>
    复制链接
  </button>

  {
    targets.map((item) => (
      <a
        class="share__btn mono"
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {item.label}
      </a>
    ))
  }

  <button class="share__btn mono" type="button" data-share-native hidden>
    更多
  </button>
</div>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-share-copy]');

  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.url ?? location.href;
    try {
      await navigator.clipboard.writeText(url);
      const original = copyBtn.textContent;
      copyBtn.textContent = '已复制 ✓';
      window.setTimeout(() => {
        copyBtn.textContent = original;
      }, 1600);
    } catch {
      copyBtn.textContent = '复制失败';
    }
  });

  const nativeBtn = document.querySelector<HTMLButtonElement>('[data-share-native]');
  if (nativeBtn && typeof navigator.share === 'function') {
    nativeBtn.hidden = false;
    nativeBtn.addEventListener('click', () => {
      void navigator.share({ title: document.title, url: copyBtn?.dataset.url ?? location.href });
    });
  }
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }

  .share__label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-right: 4px;
  }

  .share__btn {
    font-size: 11.5px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--surface);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .share__btn:hover {
    color: var(--accent-strong);
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }
</style>
