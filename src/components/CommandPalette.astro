<div class="cmdk" id="cmdk" hidden>
  <div class="cmdk__backdrop" data-cmdk-close></div>

  <div class="cmdk__panel" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="cmdk__head">
      <span class="cmdk__prompt mono" aria-hidden="true">&gt;</span>
      <input
        id="cmdk-input"
        class="cmdk__input mono"
        type="text"
        placeholder="搜索文章标题、标签、正文…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
        aria-controls="cmdk-list"
      />
      <kbd class="cmdk__kbd mono">esc</kbd>
    </div>

    <ul class="cmdk__list" id="cmdk-list" role="listbox" aria-label="搜索结果"></ul>

    <div class="cmdk__foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>ctrl</kbd><kbd>k</kbd> 关闭</span>
    </div>
  </div>
</div>

<script>
  interface Doc {
    title: string;
    description: string;
    tags: string[];
    date: string;
    url: string;
    text: string;
  }

  const root = document.getElementById('cmdk');
  const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
  const list = document.getElementById('cmdk-list');
  if (!root || !input || !list) throw new Error('cmdk: 缺少必要节点');

  let docs: Doc[] = [];
  let loading = false;
  let loaded = false;
  let activeIndex = 0;
  let current: Doc[] = [];

  const load = async () => {
    if (loaded || loading) return;
    loading = true;
    try {
      const res = await fetch('/search.json');
      docs = (await res.json()) as Doc[];
      loaded = true;
    } catch {
      docs = [];
    } finally {
      loading = false;
    }
  };

  /** 用 DOM 拼高亮，避免 innerHTML 注入 */
  const highlight = (text: string, terms: string[]): DocumentFragment => {
    const frag = document.createDocumentFragment();
    if (terms.length === 0) {
      frag.append(text);
      return frag;
    }
    const pattern = new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
    let last = 0;
    for (const match of text.matchAll(pattern)) {
      const at = match.index ?? 0;
      if (at > last) frag.append(text.slice(last, at));
      const mark = document.createElement('mark');
      mark.textContent = match[0];
      frag.append(mark);
      last = at + match[0].length;
    }
    if (last < text.length) frag.append(text.slice(last));
    return frag;
  };

  const score = (doc: Doc, terms: string[]): number => {
    const title = doc.title.toLowerCase();
    const tags = doc.tags.join(' ').toLowerCase();
    const desc = doc.description.toLowerCase();
    const body = doc.text.toLowerCase();

    let total = 0;
    for (const term of terms) {
      const hit = (hay: string, weight: number) => {
        if (!hay.includes(term)) return 0;
        total += weight;
        return 0;
      };
      hit(title, 20);
      hit(tags, 10);
      hit(desc, 6);
      hit(body, 3);
    }
    const all = terms.every(
      (t) => title.includes(t) || tags.includes(t) || desc.includes(t) || body.includes(t)
    );
    return all ? total : 0;
  };

  const render = (items: Doc[], terms: string[]) => {
    current = items;
    activeIndex = Math.min(activeIndex, Math.max(items.length - 1, 0));
    list.replaceChildren();

    if (items.length === 0) {
      const li = document.createElement('li');
      li.className = 'cmdk__empty mono';
      li.textContent = terms.length > 0 ? '没有匹配的文章' : '暂无文章';
      list.append(li);
      return;
    }

    items.forEach((doc, i) => {
      const li = document.createElement('li');
      li.className = 'cmdk__item';
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false');
      if (i === activeIndex) li.classList.add('is-active');

      const date = document.createElement('span');
      date.className = 'cmdk__date mono';
      date.textContent = doc.date.replaceAll('-', '.');

      const body = document.createElement('span');
      body.className = 'cmdk__body';

      const title = document.createElement('span');
      title.className = 'cmdk__title mono';
      title.append(highlight(doc.title, terms));

      const desc = document.createElement('span');
      desc.className = 'cmdk__desc';
      desc.append(highlight(doc.description, terms));

      body.append(title, desc);

      const tags = document.createElement('span');
      tags.className = 'cmdk__tags mono';
      tags.textContent = doc.tags.slice(0, 2).map((t) => `#${t}`).join(' ');

      li.append(date, body, tags);
      li.addEventListener('click', () => go(doc.url));
      li.addEventListener('mousemove', () => {
        if (activeIndex !== i) {
          activeIndex = i;
          markActive();
        }
      });

      list.append(li);
    });
  };

  const markActive = () => {
    [...list.children].forEach((li, i) => {
      const on = i === activeIndex;
      li.classList.toggle('is-active', on);
      li.setAttribute('aria-selected', on ? 'true' : 'false');
      if (on) li.scrollIntoView({ block: 'nearest' });
    });
  };

  const go = (url: string) => {
    close();
    location.href = url;
  };

  const search = (raw: string) => {
    const query = raw.trim().toLowerCase();
    const terms = query.split(/\s+/).filter(Boolean);

    if (terms.length === 0) {
      activeIndex = 0;
      render(docs.slice(0, 6), []);
      return;
    }

    const hits = docs
      .map((doc) => ({ doc, s: score(doc, terms) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 12)
      .map((r) => r.doc);

    activeIndex = 0;
    render(hits, terms);
  };

  const open = async () => {
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    input.focus();
    await load();
    search('');
  };

  const close = () => {
    root.hidden = true;
    document.body.style.overflow = '';
  };

  input.addEventListener('input', () => search(input.value));

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      activeIndex = Math.min(activeIndex + 1, current.length - 1);
      markActive();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      markActive();
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const doc = current[activeIndex];
      if (doc) go(doc.url);
    } else if (event.key === 'Escape') {
      close();
    }
  });

  root.querySelectorAll('[data-cmdk-close]').forEach((el) => {
    el.addEventListener('click', close);
  });

  document.addEventListener('keydown', (event) => {
    const key = event.key.toLowerCase();
    if ((event.metaKey || event.ctrlKey) && key === 'k') {
      event.preventDefault();
      if (root.hidden) void open();
      else close();
    }
    if (event.key === 'Escape' && !root.hidden) close();
  });

  // 头部搜索按钮优先唤起面板，无 JS 时退化为跳转 /search/
  document.querySelectorAll('[data-open-cmdk]').forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      void open();
    });
  });

  // 预取索引，首屏空闲时加载，打开面板无需等待
  const idle = (
    window as Window & { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number }
  ).requestIdleCallback;

  if (typeof idle === 'function') {
    idle(() => void load(), { timeout: 3000 });
  } else {
    window.setTimeout(() => void load(), 2000);
  }
</script>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 16px 16px;
  }

  .cmdk[hidden] {
    display: none;
  }

  .cmdk__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 8, 12, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  [data-theme='light'] .cmdk__backdrop {
    background: rgba(18, 24, 29, 0.28);
  }

  .cmdk__panel {
    position: relative;
    width: 100%;
    max-width: 580px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.75);
    overflow: hidden;
    animation: cmdk-in 0.16s ease-out;
  }

  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.99);
    }
  }

  .cmdk__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
  }

  .cmdk__prompt {
    color: var(--accent);
    font-size: 15px;
  }

  .cmdk__input {
    flex: 1;
    min-width: 0;
    padding: 15px 0;
    border: none;
    background: none;
    color: var(--text);
    font-size: 14.5px;
    outline: none;
  }

  .cmdk__input::placeholder {
    color: var(--text-dim);
  }

  .cmdk__kbd,
  .cmdk__foot kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
    background: var(--surface-2);
  }

  .cmdk__list {
    list-style: none;
    padding: 6px;
    margin: 0;
    max-height: min(52vh, 420px);
    overflow-y: auto;
  }

  .cmdk__item {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border-left: 2px solid transparent;
  }

  .cmdk__item.is-active {
    background: var(--accent-soft);
    border-left-color: var(--accent);
  }

  .cmdk__date {
    font-size: 11px;
    color: var(--text-dim);
  }

  .cmdk__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cmdk__title {
    font-size: 13.5px;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk__desc {
    font-size: 11.5px;
    color: var(--text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk__tags {
    font-size: 10.5px;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .cmdk__empty {
    padding: 24px 12px;
    text-align: center;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .cmdk__foot {
    display: flex;
    gap: 16px;
    padding: 9px 14px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 10.5px;
    color: var(--text-dim);
  }

  .cmdk__foot kbd + kbd {
    margin-left: 2px;
  }

  :global(.cmdk mark) {
    background: transparent;
    color: var(--accent-strong);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .cmdk {
      padding-top: 8vh;
    }

    .cmdk__item {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .cmdk__date,
    .cmdk__tags {
      display: none;
    }

    .cmdk__foot {
      display: none;
    }
  }
</style>
