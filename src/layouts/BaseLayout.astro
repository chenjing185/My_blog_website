---
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, type = 'website', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} data-theme="dark">
  <head>
    <!-- 主题必须在首次绘制前确定，避免白屏闪烁 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />

    <CommandPalette />

    <script>
      /* ---------- 1. 代码块：复制按钮 + 长代码折叠 ---------- */
      const COLLAPSE_HEIGHT = 460;

      document.querySelectorAll('pre.astro-code').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = 'COPY';
        btn.setAttribute('aria-label', '复制代码');

        btn.addEventListener('click', async () => {
          const text = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'COPIED';
            btn.dataset.copied = 'true';
          } catch {
            btn.textContent = 'FAILED';
          }
          window.setTimeout(() => {
            btn.textContent = 'COPY';
            btn.dataset.copied = 'false';
          }, 1600);
        });

        wrap.appendChild(btn);

        // 超长代码折叠
        if (pre.scrollHeight > COLLAPSE_HEIGHT + 80) {
          wrap.classList.add('is-collapsible');

          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'code-expand mono';
          toggle.textContent = '展开全部 ↓';
          toggle.addEventListener('click', () => {
            const expanded = wrap.classList.toggle('is-expanded');
            toggle.textContent = expanded ? '收起 ↑' : '展开全部 ↓';
          });
          wrap.appendChild(toggle);
        }
      });

      /* ---------- 2. 正文图片点击放大 ---------- */
      const figures = document.querySelectorAll<HTMLImageElement>('.prose img');

      if (figures.length > 0) {
        const overlay = document.createElement('div');
        overlay.className = 'img-zoom';
        overlay.innerHTML = '<img alt="" />';
        document.body.appendChild(overlay);

        const zoomed = overlay.querySelector('img')!;
        const close = () => overlay.classList.remove('is-open');

        figures.forEach((img) => {
          img.classList.add('is-zoomable');
          img.addEventListener('click', () => {
            zoomed.src = img.currentSrc || img.src;
            zoomed.alt = img.alt;
            overlay.classList.add('is-open');
          });
        });

        overlay.addEventListener('click', close);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') close();
        });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 100;
    padding: 8px 14px;
    background: var(--accent);
    color: #04120f;
    font-family: var(--font-mono);
    font-size: 13px;
    border-radius: 0 0 8px 8px;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }
</style>
