---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, groupByYear } from '../../utils/posts';

const posts = await getPosts();
const groups = groupByYear(posts);
---

<BaseLayout title="全部文章" description="按年份归档的全部文章列表。">
  <div class="shell">
    <header class="page-head">
      <p class="page-head__path mono">
        <span class="dim">~/</span>blog<span class="dim">/</span>
      </p>
      <h1 class="page-head__title">全部文章</h1>
      <p class="page-head__desc mono">
        共 {posts.length} 篇 · 按年份归档
      </p>
    </header>

    {
      groups.length > 0 ? (
        groups.map((group) => (
          <section class="year-group">
            <div class="year-group__head">
              <h2 class="year-group__year">{group.year}</h2>
              <span class="year-group__count">{group.posts.length} 篇</span>
              <span class="year-group__line" />
            </div>
            <ul class="post-list">
              {group.posts.map((post) => (
                <PostCard post={post} />
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="muted mono">还没有文章。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 48px;
  }

  .page-head__path {
    font-size: 12.5px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .page-head__title {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__desc {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .year-group + .year-group {
    margin-top: 48px;
  }

  .year-group__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .year-group__year {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .year-group__count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .year-group__line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
</style>
