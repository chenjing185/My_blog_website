---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, getNeighbors, tagSlug } from '../../utils/posts';
import { formatDate, formatDateCN, readingTime, stripMarkdown } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, subtitle } = post.data;

const all = await getPosts();
const { prev, next } = getNeighbors(all, post);

const plain = stripMarkdown(post.body);
const chars = plain.replace(/\s/g, '').length;
const minutes = readingTime(post.body);
---

<BaseLayout title={title} description={description} image={cover} type="article">
  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="shell">
    <div class="post-grid">
      <article class="post">
        <header class="post-head">
          <a class="post-head__back mono" href="/blog/">
            <span aria-hidden="true">←</span> ~/blog
          </a>

          <h1 class="post-head__title">{title}</h1>

          {subtitle && <p class="post-head__subtitle">{subtitle}</p>}

          <div class="post-head__meta mono">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            <span class="sep">·</span>
            <span>{minutes} min read</span>
            <span class="sep">·</span>
            <span>{chars.toLocaleString('en-US')} 字</span>
            {
              updatedDate && (
                <>
                  <span class="sep">·</span>
                  <span class="post-head__updated">更新于 {formatDateCN(updatedDate)}</span>
                </>
              )
            }
          </div>

          {
            tags.length > 0 && (
              <ul class="tag-list post-head__tags">
                {tags.map((tag) => (
                  <li>
                    <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <div class="post-mobile-toc">
          <TableOfContents headings={headings} mobile />
        </div>

        <div class="prose">
          <Content />
        </div>

        <footer class="post-foot">
          <div class="post-nav">
            {
              prev ? (
                <a class="post-nav__item post-nav__item--prev" href={`/blog/${prev.id}/`}>
                  <span class="post-nav__label mono">← prev</span>
                  <span class="post-nav__title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a class="post-nav__item post-nav__item--next" href={`/blog/${next.id}/`}>
                  <span class="post-nav__label mono">next →</span>
                  <span class="post-nav__title">{next.data.title}</span>
                </a>
              )
            }
          </div>

          <div class="post-foot__end mono">
            <span class="dim">EOF</span>
            <a href="/blog/">返回列表</a>
            <a href="#top">回到顶部 ↑</a>
          </div>
        </footer>
      </article>

      <aside class="post-aside">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 196px;
    gap: 72px;
    align-items: start;
  }

  .post {
    min-width: 0;
    max-width: var(--prose);
  }

  .post-head {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .post-head__back {
    display: inline-block;
    font-size: 12.5px;
    color: var(--text-dim);
    margin-bottom: 20px;
    transition: color 0.15s;
  }

  .post-head__back:hover {
    color: var(--accent);
  }

  .post-head__title {
    font-family: var(--font-mono);
    font-size: clamp(1.55rem, 3.4vw, 2.15rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .post-head__subtitle {
    margin-top: 12px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .sep {
    color: var(--border-strong);
  }

  .post-head__updated {
    color: var(--text-dim);
  }

  .post-head__tags {
    margin-top: 18px;
  }

  .post-mobile-toc {
    display: none;
  }

  /* 文末导航 */
  .post-foot {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s, background 0.15s;
    min-width: 0;
  }

  .post-nav__item:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .post-nav__item--next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav__label {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }

  .post-nav__title {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .post-foot__end {
    display: flex;
    gap: 20px;
    margin-top: 32px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-foot__end a:hover {
    color: var(--accent);
  }

  .post-foot__end .dim {
    margin-right: auto;
    letter-spacing: 0.14em;
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .post-aside {
      display: none;
    }

    .post-mobile-toc {
      display: block;
    }

    .post {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 顶部阅读进度条
  const bar = document.getElementById('progress');
  if (bar) {
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const ratio = max > 0 ? h.scrollTop / max : 0;
      bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
