---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Giscus from '../../components/Giscus.astro';
import { SITE, STATS } from '../../consts';
import {
  getPosts,
  getNeighbors,
  tagSlug,
  categorySlug,
  seriesContext,
  relatedPosts,
  postUrl,
} from '../../utils/posts';
import { formatDate, formatDateCN, readingTime, stripMarkdown } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  cover,
  subtitle,
  category,
  series,
  link,
} = post.data;

const all = await getPosts();
const { prev, next } = getNeighbors(all, post);
const seriesInfo = seriesContext(all, post);
const related = relatedPosts(all, post, 3);

const plain = stripMarkdown(post.body);
const chars = plain.replace(/\s/g, '').length;
const minutes = readingTime(post.body);

const canonical = new URL(postUrl(post), Astro.site ?? Astro.url).href;
const showPageViews = STATS.enabled && STATS.showPageViews;
---

<BaseLayout title={title} description={description} image={cover} type="article">
  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="shell" id="top">
    <div class="post-grid">
      <article class="post">
        <header class="post-head">
          <a class="post-head__back mono" href="/blog/">
            <span aria-hidden="true">←</span> ~/blog
          </a>

          {
            seriesInfo && (
              <a class="series-banner mono" href={`/collections/${seriesInfo.slug}/`}>
                <span class="series-banner__label">专栏</span>
                <span class="series-banner__name">{seriesInfo.label}</span>
                <span class="series-banner__progress">
                  第 {seriesInfo.index} / {seriesInfo.total} 篇
                </span>
              </a>
            )
          }

          <h1 class="post-head__title">{title}</h1>

          {subtitle && <p class="post-head__subtitle">{subtitle}</p>}

          <div class="post-head__meta mono">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            <span class="sep">·</span>
            {
              category && (
                <>
                  <a class="post-head__cat" href={`/categories/${categorySlug(category)}/`}>
                    {category}
                  </a>
                  <span class="sep">·</span>
                </>
              )
            }
            <span>{minutes} min read</span>
            <span class="sep">·</span>
            <span>{chars.toLocaleString('en-US')} 字</span>
            {
              updatedDate && (
                <>
                  <span class="sep">·</span>
                  <span class="post-head__updated">更新于 {formatDateCN(updatedDate)}</span>
                </>
              )
            }
          </div>

          {
            tags.length > 0 && (
              <ul class="tag-list post-head__tags">
                {tags.map((tag) => (
                  <li>
                    <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <div class="post-mobile-toc">
          <TableOfContents headings={headings} mobile />
        </div>

        {
          link && (
            <div class="ext-notice">
              <p class="ext-notice__text mono">
                这是一篇外链文章，正文托管在站外。
              </p>
              <a class="btn ext-notice__btn" href={link} target="_blank" rel="noopener noreferrer">
                前往阅读 <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <div class="post-end">
          <div class="copyright mono">
            <p>
              <span class="dim">作者</span> <a href="/">{SITE.author.name}</a>
              <span class="dim">·</span>
              <span class="dim">发布</span>
              <a href={canonical}>{formatDate(pubDate)}</a>
              {series && (
                <>
                  <span class="dim">·</span>
                  <span class="dim">专栏</span> <span>{series}</span>
                </>
              )}
            </p>
            <p>
              <span class="dim">许可</span> 本文采用
              <a
                href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
                target="_blank"
                rel="noopener noreferrer">CC BY-NC-SA 4.0</a
              >
              许可，转载请注明出处。
            </p>
            {
              showPageViews && (
                <p>
                  <span class="dim">阅读</span>
                  <span id="busuanzi_value_page_pv">—</span>
                  <span class="dim">次</span>
                </p>
              )
            }
          </div>

          <ShareButtons url={canonical} title={title} />
        </div>

        <RelatedPosts posts={related} />

        <footer class="post-foot">
          {
            seriesInfo && (seriesInfo.prev || seriesInfo.next) && (
              <div class="series-nav">
                <p class="series-nav__label mono">同专栏 · {seriesInfo.label}</p>
                <div class="series-nav__grid">
                  {seriesInfo.prev ? (
                    <a class="series-nav__item" href={`/blog/${seriesInfo.prev.id}/`}>
                      <span class="series-nav__dir mono">← 上一篇</span>
                      <span class="series-nav__title">{seriesInfo.prev.data.title}</span>
                    </a>
                  ) : (
                    <span />
                  )}
                  {seriesInfo.next && (
                    <a class="series-nav__item series-nav__item--next" href={`/blog/${seriesInfo.next.id}/`}>
                      <span class="series-nav__dir mono">下一篇 →</span>
                      <span class="series-nav__title">{seriesInfo.next.data.title}</span>
                    </a>
                  )}
                </div>
              </div>
            )
          }

          <div class="post-nav">
            {
              prev ? (
                <a class="post-nav__item post-nav__item--prev" href={`/blog/${prev.id}/`}>
                  <span class="post-nav__label mono">← prev</span>
                  <span class="post-nav__title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next && (
                <a class="post-nav__item post-nav__item--next" href={`/blog/${next.id}/`}>
                  <span class="post-nav__label mono">next →</span>
                  <span class="post-nav__title">{next.data.title}</span>
                </a>
              )
            }
          </div>

          <div class="post-foot__end mono">
            <span class="dim">EOF</span>
            <a href="/blog/">返回列表</a>
            <a href="#top">回到顶部 ↑</a>
          </div>
        </footer>

        <Giscus />
      </article>

      <aside class="post-aside">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 196px;
    gap: 72px;
    align-items: start;
  }

  .post {
    min-width: 0;
    max-width: var(--prose);
  }

  .post-head {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .post-head__back {
    display: inline-block;
    font-size: 12.5px;
    color: var(--text-dim);
    margin-bottom: 20px;
    transition: color 0.15s;
  }

  .post-head__back:hover {
    color: var(--accent);
  }

  .post-head__title {
    font-family: var(--font-mono);
    font-size: clamp(1.55rem, 3.4vw, 2.15rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .post-head__subtitle {
    margin-top: 12px;
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .sep {
    color: var(--border-strong);
  }

  .post-head__updated {
    color: var(--text-dim);
  }

  .post-head__tags {
    margin-top: 18px;
  }

  .post-mobile-toc {
    display: none;
  }

  /* 文末导航 */
  .post-foot {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .post-nav__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s, background 0.15s;
    min-width: 0;
  }

  .post-nav__item:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
  }

  .post-nav__item--next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav__label {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }

  .post-nav__title {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .post-foot__end {
    display: flex;
    gap: 20px;
    margin-top: 32px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-foot__end a:hover {
    color: var(--accent);
  }

  .post-foot__end .dim {
    margin-right: auto;
    letter-spacing: 0.14em;
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .post-aside {
      display: none;
    }

    .post-mobile-toc {
      display: block;
    }

    .post {
      max-width: none;
    }
  }

  /* 专栏徽标 */
  .series-banner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 11.5px;
    color: var(--text-muted);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .series-banner:hover {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .series-banner__label {
    color: var(--accent);
    font-size: 10.5px;
    letter-spacing: 0.08em;
  }

  .series-banner__progress {
    color: var(--text-dim);
    font-size: 10.5px;
    padding-left: 8px;
    border-left: 1px solid var(--border);
  }

  .post-head__cat {
    color: var(--accent);
  }

  .post-head__cat:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 外链文章提示 */
  .ext-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    margin-bottom: 32px;
    border: 1px dashed var(--accent-line);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .ext-notice__text {
    font-size: 12.5px;
    color: var(--text-muted);
    margin: 0;
  }

  .ext-notice__btn {
    margin-left: auto;
  }

  /* 版权与分享 */
  .post-end {
    margin-top: 44px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .copyright {
    font-size: 12px;
    line-height: 2;
    color: var(--text-muted);
  }

  .copyright p {
    margin: 0;
  }

  .copyright a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-underline-offset: 3px;
  }

  .copyright a:hover {
    color: var(--accent);
  }

  .copyright .dim {
    margin-right: 4px;
    opacity: 0.8;
  }

  /* 同专栏上下篇 */
  .series-nav {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px dashed var(--border);
  }

  .series-nav__label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .series-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .series-nav__item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px 14px;
    border-left: 2px solid var(--border-strong);
    transition: border-color 0.15s, background 0.15s;
  }

  .series-nav__item:hover {
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }

  .series-nav__item--next {
    text-align: right;
    align-items: flex-end;
    border-left: none;
    border-right: 2px solid var(--border-strong);
  }

  .series-nav__item--next:hover {
    border-right-color: var(--accent);
  }

  .series-nav__dir {
    font-size: 10.5px;
    color: var(--accent);
    opacity: 0.85;
  }

  .series-nav__title {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text);
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .series-nav__grid {
      grid-template-columns: 1fr;
    }

    .ext-notice__btn {
      margin-left: 0;
    }
  }
</style>

<script>
  // 顶部阅读进度条
  const bar = document.getElementById('progress');
  if (bar) {
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const ratio = max > 0 ? h.scrollTop / max : 0;
      bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
