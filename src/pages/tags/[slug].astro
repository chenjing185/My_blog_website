---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, collectTags, tagSlug, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((tag) => ({
    params: { slug: tag.slug },
    props: {
      label: tag.label,
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === tag.slug)),
    },
  }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`标签：${label}`} description={`标签「${label}」下的全部文章，共 ${posts.length} 篇。`}>
  <div class="shell">
    <header class="page-head">
      <p class="page-head__path mono"><span class="dim">~/</span>tags<span class="dim">/</span></p>
      <h1 class="page-head__title">#{label}</h1>
      <p class="page-head__desc mono">{posts.length} 篇文章</p>
    </header>

    <ul class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </ul>

    <p class="page-foot mono">
      <a href="/tags/">← 全部标签</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 32px;
  }

  .page-head__path {
    font-size: 12.5px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .page-head__title {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__desc {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .page-foot {
    margin-top: 40px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .page-foot a:hover {
    color: var(--accent);
  }
</style>
