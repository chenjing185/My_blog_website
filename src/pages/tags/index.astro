---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, collectTags } from '../../utils/posts';

const posts = await getPosts();
const tags = collectTags(posts);
const total = tags.reduce((sum, t) => sum + t.count, 0);
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
  <div class="shell">
    <header class="page-head">
      <p class="page-head__path mono"><span class="dim">~/</span>tags<span class="dim">/</span></p>
      <h1 class="page-head__title">标签</h1>
      <p class="page-head__desc mono">{tags.length} 个标签 · 累计 {total} 次引用</p>
    </header>

    {
      tags.length > 0 ? (
        <ul class="tag-index">
          {tags.map((tag) => (
            <li>
              <a class="tag-index__row" href={`/tags/${tag.slug}/`}>
                <span class="tag-index__name mono">#{tag.label}</span>
                <span class="tag-index__leader" aria-hidden="true" />
                <span class="tag-index__count mono">{String(tag.count).padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted mono">还没有标签。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 40px;
  }

  .page-head__path {
    font-size: 12.5px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .page-head__title {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .page-head__desc {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  .tag-index {
    list-style: none;
    padding: 0;
    max-width: 560px;
  }

  .tag-index__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
    transition: color 0.15s, padding-left 0.15s, border-color 0.15s;
  }

  .tag-index__row:hover {
    color: var(--accent-strong);
    padding-left: 10px;
    border-color: var(--accent-line);
  }

  .tag-index__name {
    font-size: 14.5px;
  }

  .tag-index__leader {
    flex: 1;
    border-bottom: 1px dotted var(--border-strong);
    transform: translateY(-4px);
  }

  .tag-index__count {
    font-size: 12px;
    color: var(--text-dim);
  }

  .tag-index__row:hover .tag-index__count {
    color: var(--accent);
  }
</style>
