---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, collectSeries, postUrl, type Post } from '../../utils/posts';
import { formatDate, readingTime } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectSeries(posts).map((series) => ({
    params: { slug: series.slug },
    props: { label: series.label, posts: series.posts },
  }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;
const totalMinutes = posts.reduce((n, p) => n + readingTime(p.body), 0);
---

<BaseLayout title={`专栏：${label}`} description={`专栏「${label}」的完整目录，共 ${posts.length} 篇。`}>
  <div class="shell">
    <PageHeader
      path={`~/collections/${label}`}
      title={label}
      desc={`${posts.length} 篇 · 约 ${totalMinutes} 分钟读完 · 按发布顺序排列`}
    />

    <ol class="series">
      {
        posts.map((post, i) => (
          <li class="series__item">
            <a class="series__link" href={postUrl(post)}>
              <span class="series__index mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="series__body">
                <span class="series__title">{post.data.title}</span>
                <span class="series__desc">{post.data.description}</span>
              </span>
              <span class="series__meta mono">
                {formatDate(post.data.pubDate).slice(5)}
                <span class="dim"> · </span>
                {readingTime(post.body)} min
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="page-foot mono">
      <a href="/collections/">← 全部专栏</a>
    </p>
  </div>
</BaseLayout>

<style>
  .series {
    list-style: none;
    padding: 0;
    counter-reset: series;
    border-left: 1px solid var(--border);
    margin-left: 6px;
  }

  .series__item + .series__item {
    border-top: 1px solid var(--border);
  }

  .series__link {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
    padding: 18px 12px 18px 0;
    margin-left: -1px;
    transition: background 0.18s;
  }

  .series__link::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 26px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong);
    transition: background 0.18s;
  }

  .series__link:hover {
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
  }

  .series__link:hover::before {
    background: var(--accent);
  }

  .series__index {
    padding-left: 22px;
    font-size: 13px;
    color: var(--accent);
    opacity: 0.8;
    padding-top: 2px;
  }

  .series__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .series__title {
    font-family: var(--font-mono);
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text);
    transition: color 0.15s;
  }

  .series__link:hover .series__title {
    color: var(--accent-strong);
  }

  .series__desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .series__meta {
    font-size: 11.5px;
    color: var(--text-dim);
    white-space: nowrap;
    padding-top: 3px;
  }

  .page-foot {
    margin-top: 40px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .page-foot a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .series__link {
      grid-template-columns: 44px minmax(0, 1fr);
    }

    .series__meta {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
